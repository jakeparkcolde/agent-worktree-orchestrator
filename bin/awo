#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Agent Worktree Orchestrator

Usage:
  awo doctor
  awo status <project>
  awo start <project> <task-name> [agent] [goal] [--worktree PATH] [--new-session]
  awo request <text> [--project KEY] [--goal GOAL] [--task NAME] [--advise none|jev] [--apply]
  awo jev-trial status|report [--json]
  awo jev-trial feedback EVENT_ID --result accepted|corrected|uncertain [--critical-misroute] [--json]
  awo finish [repo-path]
  awo audit <project> [--json]
  awo watch <project> [--json] [--notify] [--sessions]
  awo sessions [--json] [--threshold-hours HOURS]
  awo terminals <project> [--threshold-hours HOURS] [--close-safe [--apply]] [--json]
  awo launchd install|uninstall [<project>] [--job watch|report] [--apply] [--notify]
  awo report [--save] [--notify] [--json]
  awo ledger record|ingest-codex|who <file>|files --terminal H
  awo guard                        (Claude PreToolUse hook; reads JSON on stdin)
  awo hooks install|uninstall|status [--apply]
  awo shared [--repo NAME=PATH ...] [--json]
  awo --version
  awo cleanup <project> [--worktree PATH | --all-safe] [--apply] [--json]
  awo help
EOF
}

cmd="${1:-help}"
case "$cmd" in
  --version|version)
    cat "$ROOT/VERSION"
    ;;
  doctor)
    exec "$ROOT/scripts/doctor.sh"
    ;;
  status)
    shift
    exec "$ROOT/scripts/repo-status.sh" "$@"
    ;;
  start)
    shift
    exec "$ROOT/scripts/task-start.sh" "$@"
    ;;
  request)
    shift
    exec python3 "$ROOT/scripts/awo_request.py" "$@"
    ;;
  jev-trial)
    shift
    exec python3 "$ROOT/scripts/awo_jev_trial.py" "$@"
    ;;
  finish)
    shift
    exec "$ROOT/scripts/task-finish.sh" "$@"
    ;;
  sessions)
    shift
    exec python3 "$ROOT/scripts/awo_sessions.py" "$@"
    ;;
  terminals)
    shift
    exec python3 "$ROOT/scripts/awo_terminals.py" "$@"
    ;;
  report)
    shift
    exec python3 "$ROOT/scripts/awo_report.py" "$@"
    ;;
  ledger)
    shift
    exec python3 "$ROOT/scripts/awo_ledger.py" "$@"
    ;;
  guard)
    shift
    exec python3 "$ROOT/scripts/awo_guard.py" "$@"
    ;;
  hooks)
    shift
    exec python3 "$ROOT/scripts/awo_hooks.py" "$@"
    ;;
  shared)
    shift
    exec python3 "$ROOT/scripts/awo_shared.py" "$@"
    ;;
  launchd)
    shift
    exec python3 "$ROOT/scripts/awo_launchd.py" "$@"
    ;;
  audit|watch)
    shift
    exec python3 "$ROOT/scripts/awo_audit.py" "$cmd" "$@"
    ;;
  cleanup)
    shift
    exec "$ROOT/scripts/cleanup.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
