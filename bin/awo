#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Agent Worktree Orchestrator

Usage:
  awo doctor
  awo status <project>
  awo start <project> <task-name> [agent] [goal] [--worktree PATH] [--new-session]
  awo finish [repo-path]
  awo audit <project> [--json]
  awo watch <project> [--json] [--notify] [--sessions]
  awo sessions [--json] [--threshold-hours HOURS]
  awo launchd install|uninstall <project> [--apply] [--notify]
  awo --version
  awo cleanup <project> [--worktree PATH | --all-safe] [--apply] [--json]
  awo help
EOF
}

cmd="${1:-help}"
case "$cmd" in
  --version|version)
    cat "$ROOT/VERSION"
    ;;
  doctor)
    exec "$ROOT/scripts/doctor.sh"
    ;;
  status)
    shift
    exec "$ROOT/scripts/repo-status.sh" "$@"
    ;;
  start)
    shift
    exec "$ROOT/scripts/task-start.sh" "$@"
    ;;
  finish)
    shift
    exec "$ROOT/scripts/task-finish.sh" "$@"
    ;;
  sessions)
    shift
    exec python3 "$ROOT/scripts/awo_sessions.py" "$@"
    ;;
  launchd)
    shift
    exec python3 "$ROOT/scripts/awo_launchd.py" "$@"
    ;;
  audit|watch)
    shift
    exec python3 "$ROOT/scripts/awo_audit.py" "$cmd" "$@"
    ;;
  cleanup)
    shift
    exec "$ROOT/scripts/cleanup.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
